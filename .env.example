# Supabase 配置
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# 服务端使用（Vercel 环境变量；缺则职业探索等不会写入 usage_logs）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# 可选别名（若 Vercel 未同步 VITE_*）：与上方二选一或同时配置
# 重要：Vercel 上「支付回调 /api/xorpay/notify」与「补单 /api/user/repair-subscription」必须能解析到项目 URL，
# 否则只配 SUPABASE_URL 而不配 VITE_SUPABASE_URL 也可以，代码会读 SUPABASE_URL。
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=

# Gemini API（仅服务端使用，不要以 VITE_ 开头）
GEMINI_API_KEY=your_gemini_api_key
# 职业探索：每用户每日成功调用上限（仅统计 career_explore_* 写入 usage_logs 的次数），默认 50
CAREER_EXPLORE_DAILY_MAX=50
# 本地开发用（可选，会暴露到客户端）
VITE_GEMINI_API_KEY=
# 本地 OCR/文件提取不可用时，设置此项走线上代理：VITE_REMOTE_PROXY_URL=https://offerin.co
VITE_REMOTE_PROXY_URL=

# Upstash Redis（分布式 Rate Limiting；生产环境 proxy 要求配置）
# 获取方式：https://console.upstash.com/ 打开数据库 → REST API → 复制 URL 与 TOKEN
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
# Vercel 日志若出现 WRONGPASS / 401：TOKEN 与控制台不一致（复制错库、多余空格、轮换后未更新）
# 失败时会回退内存限流（多实例不共享），不影响 Supabase 记账；记账失败请查 usage_logs 的 CHECK 约束（见 migrations/020）

# 支付：App ID 可 VITE_ 供前端展示；密钥仅服务端变量，勿用 VITE_ 前缀
VITE_XORPAY_APP_ID=
XORPAY_APP_ID=
XORPAY_APP_SECRET=
# 服务端固定 XorPay 异步回调；不填则默认 https://offerin.co/api/xorpay/notify
XORPAY_NOTIFY_URL=
